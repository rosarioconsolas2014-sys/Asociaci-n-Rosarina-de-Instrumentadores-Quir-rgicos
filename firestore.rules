rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // HELPER FUNCTIONS & GUARDS
    // =========================================================================
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // =========================================================================
    // 1. INSTITUTIONAL SETTINGS (ARIQ official data, authorities, texts, logo)
    // =========================================================================
    match /institutional_settings/{settingId} {
      allow read: if true;
      allow write: if isValidId(settingId);
    }

    // =========================================================================
    // 2. NEWS CATEGORIES
    // =========================================================================
    match /news_categories/{categoryId} {
      allow read: if true;
      allow write: if isValidId(categoryId);
    }

    // =========================================================================
    // 3. NEWS ARTICLES (Base64 compressed image <= 300KB)
    // =========================================================================
    match /news/{newsId} {
      allow read: if true;
      allow write: if isValidId(newsId);
    }

    // =========================================================================
    // 4. COURSES & WORKSHOPS
    // =========================================================================
    match /courses/{courseId} {
      allow read: if true;
      allow write: if isValidId(courseId);
    }

    // =========================================================================
    // 5. COURSE REGISTRATIONS (Public submissions & admin management)
    // =========================================================================
    match /course_registrations/{registrationId} {
      allow read: if true;
      allow write: if isValidId(registrationId);
    }

    // =========================================================================
    // 6. EVENTS & CONGRESSES
    // =========================================================================
    match /events/{eventId} {
      allow read: if true;
      allow write: if isValidId(eventId);
    }

    // =========================================================================
    // 7. CONTACT INQUIRIES (Public contact form & admin reply/notes)
    // =========================================================================
    match /contact_messages/{messageId} {
      allow read: if true;
      allow write: if isValidId(messageId);
    }

    // =========================================================================
    // 8. USER PROFILES
    // =========================================================================
    match /profiles/{userId} {
      allow read: if true;
      allow write: if isValidId(userId);
    }

    // =========================================================================
    // 9. INTERNAL AUDIT LOGS (Immutable audit trail)
    // =========================================================================
    match /internal_logs/{logId} {
      allow read: if true;
      allow create: if isValidId(logId);
      allow update, delete: if false; // Logs cannot be modified or deleted
    }

    // =========================================================================
    // 10. SYSTEM HEALTH LOGS & INCIDENTS (Monitoring & Production Control)
    // =========================================================================
    match /system_health_logs/{logId} {
      allow read: if true;
      allow write: if isValidId(logId);
    }

    // =========================================================================
    // 11. ADMIN USERS (Custom authentication with bcrypt hash)
    // =========================================================================
    match /admin_users/{userId} {
      allow read: if true;
      allow write: if isValidId(userId);
    }

    // =========================================================================
    // 12. ADMIN SESSIONS (Session tokens and expiry tracking)
    // =========================================================================
    match /admin_sessions/{sessionId} {
      allow read: if true;
      allow write: if isValidId(sessionId);
    }

  }
}
