rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Default Deny
    match /{allPaths=**} {
      allow read, write: if false;
    }

    // Institutional assets (logos, official badges)
    match /institutional/{fileName} {
      allow read: if true;
      allow write: if request.auth != null &&
        request.resource.size < 5 * 1024 * 1024 &&
        request.resource.contentType.matches('image/.*');
    }

    // News article featured images
    match /news/{fileName} {
      allow read: if true;
      allow write: if request.auth != null &&
        request.resource.size < 10 * 1024 * 1024 &&
        request.resource.contentType.matches('image/.*');
    }

    // Courses and training programs banners
    match /courses/{fileName} {
      allow read: if true;
      allow write: if request.auth != null &&
        request.resource.size < 10 * 1024 * 1024 &&
        request.resource.contentType.matches('image/.*');
    }

    // Events and congresses photography
    match /events/{fileName} {
      allow read: if true;
      allow write: if request.auth != null &&
        request.resource.size < 10 * 1024 * 1024 &&
        request.resource.contentType.matches('image/.*');
    }

    // Official documents and institutional regulations
    match /documents/{fileName} {
      allow read: if true;
      allow write: if request.auth != null &&
        request.resource.size < 20 * 1024 * 1024 &&
        (request.resource.contentType == 'application/pdf' || request.resource.contentType.matches('application/.*'));
    }
  }
}
