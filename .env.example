# ARIQ — Asociación Rosarina de Instrumentadores Quirúrgicos
# Variables de entorno requeridas

# Supabase: URL de tu proyecto de Supabase (ej: https://xyzcompany.supabase.co)
VITE_SUPABASE_URL="https://tu-proyecto.supabase.co"

# Supabase: Clave anónima pública (anon key) con permisos restringidos por RLS
# NUNCA expongas la clave service_role en el frontend
VITE_SUPABASE_ANON_KEY="tu-anon-public-key-aqui"

# GEMINI_API_KEY: Inyectado por AI Studio si se requieren servicios del modelo
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: URL donde está alojada la aplicación
APP_URL="http://localhost:3000"
